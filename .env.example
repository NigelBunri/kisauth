# ==========================================
# KIS Auth — environment configuration
# Never commit real values. This file documents names only.
# ==========================================

NODE_ENV=development
PORT=4100
KISAUTH_BASE_URL=http://localhost:4100

# ---- Google OAuth / OIDC ----
# Create a dedicated OAuth client per environment — never share the
# production client's secret with development.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on the Google OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4100/oauth/google/callback

# ---- Postgres (KIS Auth's own database — never Django's) ----
KISAUTH_DATABASE_URL=postgres://kisauth:kisauth@localhost:5432/kisauth

# ---- Redis (challenge/authorization-code keyspace, namespaced kisauth:) ----
KISAUTH_REDIS_URL=redis://localhost:6379

# ---- JWT signing (RS256) ----
# PEM-encoded RSA private/public keypair. Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# In production these come from a secrets manager, never from a file
# checked into git or baked into the Docker image.
KISAUTH_JWT_PRIVATE_KEY=
KISAUTH_JWT_PUBLIC_KEY=
# Identifies which key signed a given token; bump on every rotation.
KISAUTH_JWT_KID=kisauth-2026-09
# Optional: comma-separated list of PREVIOUS (kid, public key) pairs kept in
# the JWKS during a rotation overlap window. Format: kid1:base64pem,kid2:base64pem
KISAUTH_JWT_PREVIOUS_KEYS=

# ---- Internal service-to-service signing (KIS Auth <-> Django) ----
# Distinct from the JWT signing key — compromise of one must not
# compromise the other. Reuses the existing internal-signing.ts scheme.
KISAUTH_INTERNAL_HMAC_SECRET=
INTERNAL_SIGNATURE_MAX_SKEW_SECONDS=300

# ---- Django bridge (outbound security-event forwarding) ----
DJANGO_SECURITY_EVENT_URL=http://localhost:8000/api/v1/internal/kis-auth/security-event/

# ---- Django bridge (enterprise OIDC SSO config lookup) ----
# Full URL, without the ?partner_slug=... query string — appended per
# lookup. Empty disables enterprise SSO entirely (fails closed).
DJANGO_SSO_CONFIG_URL=http://localhost:8000/api/v1/kis-auth/sso-config/

# ---- Challenge tuning ----
KISAUTH_CHALLENGE_TTL_SECONDS=30
KISAUTH_AUTH_CODE_TTL_SECONDS=60
KISAUTH_CHALLENGE_MAX_ATTEMPTS=5
